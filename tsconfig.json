{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "lib": ["ESNext"],

        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        
        "outDir": "./dist",
        "rootDir": "./src",

        "types": ["node"],

        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noEmitOnError": false,

        "verbatimModuleSyntax": true
    },
    "include": ["src"],
    "exclude": ["node_modules"]
}